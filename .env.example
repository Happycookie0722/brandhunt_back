# Local development only. Copy this file to .env and replace values as needed.
# Never commit your real .env file or use these development values in production.
JWT_SECRET=local-development-only-secret-change-this-to-a-random-value-at-least-32-bytes
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000

DB_URL=jdbc:mysql://localhost:3306/brandhunt?serverTimezone=Asia/Seoul
DB_USERNAME=root
DB_PASSWORD=replace-with-your-local-mysql-password

# Optional until email sending is used.
MAIL_USERNAME=
MAIL_PASSWORD=

REDIS_HOST=localhost
REDIS_PORT=6379
CORS_ALLOWED_ORIGIN=http://localhost:5173
