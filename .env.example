# Copy these values into your local environment. Do not commit real secrets.
JWT_SECRET=replace-with-a-random-secret-at-least-32-bytes
JWT_ACCESS_EXPIRATION=1800000
JWT_REFRESH_EXPIRATION=604800000

DB_URL=jdbc:mysql://localhost:3306/brandhunt?serverTimezone=Asia/Seoul
DB_USERNAME=root
DB_PASSWORD=replace-with-your-db-password

MAIL_USERNAME=replace-with-your-mail-account
MAIL_PASSWORD=replace-with-your-mail-app-password

REDIS_HOST=localhost
REDIS_PORT=6379
CORS_ALLOWED_ORIGIN=http://localhost:5173
